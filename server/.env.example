# Core Application Settings
PORT=3001
NODE_ENV=development

# Provider Config
PROVIDER_TIMEOUT_MS=3000
PROVIDER_RETRY_COUNT=2

# Primary Overpass API (If the primary instance returns errors, https://lz4.overpass-api.de/api/interpreter is a known-working mirror)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Secondary Overpass API (Fallback URL used when the primary provider returns 429/5xx)
# SECONDARY_OVERPASS_URL=https://lz4.overpass-api.de/api/interpreter

# RailRadar API
RAILRADAR_KEY=your_api_key_here
